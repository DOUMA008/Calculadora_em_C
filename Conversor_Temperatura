#include <stdio.h>
#include <math.h>

int main() {
    int opcao;
    float temp, resultado;
    
    printf("----Escolha----\n");
    printf("1-Celsius → Fahrenheit\n");
    printf("2-Fahrenheit → Celsius\n");
    printf("3-Celsius → Kelvin\n");
    printf("4-Kelvin → Celsius\n");
    printf("5-Fahrenheit → Kelvin\n");
    printf("6-Kelvin → Fahrenheit\n");
    printf("7-Sair\n");
    printf("--------------\n");
    
    while (1){
    
    printf("Digite a opção:");
    scanf("%d", &opcao);
    if (opcao == 7) {
        printf("Saindo...");
        break;
    }
        
    if (opcao < 1 || opcao > 6) {
        printf("Erro..., Escolha uma opção de 1 a 6 por favor!!!\n");
        continue;
    }
    
    printf("Digite a temperatura:");
    scanf("%f", &temp);
    
    if (opcao == 1) {
        resultado = (temp * 9.0 / 5.0) + 32;
        printf("A temperatura em Fahrenheit é: %.2f F\n", resultado);
    }
    else if (opcao == 2) {
        resultado = ( temp - 32) * 5.0 / 9.0;
        printf("A temperatura em Celsius é: %.2f C\n",resultado);
    }
    else if (opcao == 3) {
        resultado = temp + 273.15;
        printf("A temperatura em Kelvin é: %.2f K\n",resultado);
    }
    else if (opcao == 4) {
        resultado = temp - 273.15;
        printf("A temperatura em Celsius é: %.2f C\n", resultado);
    }
    else if (opcao == 5) {
        resultado = (temp - 32) * 5.0 / 9.0 + 273.15;
        printf("A temperatura em Kelvin é: %.2f K\n", resultado);
    }
    else if (opcao == 6) {
        resultado = (temp-273.15) * 9.0 / 5.0 + 32;
        printf("A temperatura em Fahrenheit é: %.2f F\n", resultado);
    }
        
    }
    
    return 0;
}
